ometry relative="1" as="geometry"/></mxCell><mxCell id="02_elaboracion-g5-lbl" value="REL-11  Maridaje 0*..N vinos  (mín. 0 inferido: AMB-16) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="02_elaboracion-g5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="02_elaboracion-note0" value="Lote → Bodega (REL-07): llega desde el módulo 1 (pág. 01). Roles de bodega separados (AMB-06)." style="text;html=1;fontSize=9;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="560" width="380" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="der-03_comercial" name="03_comercial_jerarquia"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="03_comercial-title" value="&lt;b&gt;A-08 · DER (3/6) — Red comercial + jerarquía de clientes (A-06)&lt;/b&gt;" style="text;html=1;fontSize=17;align=left" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="03_comercial-leg" value="Notación: K = clave candidata respaldada [R] · I = inferida · P = pendiente de validación · AK = alterna · K/FK = componente de clave y foránea · FK → subrogada de cabecera/roja (débil: clave propietaria + parcial). Colores: azul = fuerte · verde (borde discontinuo) = débil · naranja = asociativa · amarillo = inventario · violeta = supertipo · violeta claro = subtipo. Cardinalidad &quot;A x..y — z..w B&quot; por extremo (A-04); * = extremo inferido. Cajas grises = referencia repetida de otra página." style="text;html=1;fontSize=9;align=left;fillColor=#fafafa;strokeColor=#cccccc;rounded=1" vertex="1" parent="1"><mxGeometry x="30" y="52" width="820" height="30" as="geometry"/></mxCell><mxCell id="03_comercial-Localidad" value="&lt;b&gt;Localidad&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;codigo_postal  [K·pend]&lt;br/&gt;nombre&lt;br/&gt;provincia&lt;br/&gt;encargado_regional&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidatas PK pendientes (LK): codigo_postal [P]  |  (nombre, provincia) [P] (LK-1/LK-2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="117" as="geometry"/></mxCell><mxCell id="03_comercial-Sala" value="&lt;b&gt;Sala de venta&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;id_sala  [K]&lt;br/&gt;calle&lt;br/&gt;numero&lt;br/&gt;dia_cierre&lt;br/&gt;localidad  [FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: id_sala [R · &amp;quot;ID&amp;quot; sec. 5]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="200" height="132" as="geometry"/></mxCell><mxCell id="03_comercial-Empleado" value="&lt;b&gt;Empleado&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;cuit  [K·inf condicionada]&lt;br/&gt;nombre&lt;br/&gt;fecha_ingreso&lt;br/&gt;salario&lt;br/&gt;sala  [FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: cuit [I condicionada a persona física con CUIT propio; sin UNIQUE textual; EK-a]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x=