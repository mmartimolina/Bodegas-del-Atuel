lbl" value="REL-20  Ingreso 1*..N* vinos  [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="05_logistica-l5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="05_logistica-l6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="05_logistica-RenglonIngreso" target="05_logistica-Vino_l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="05_logistica-l6-lbl" value="REL-20  Vino 0*..N ingresos  [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="05_logistica-l6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="der-06_stock_auditoria" name="06_stock_auditoria"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="805" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="06_stock_auditoria-title" value="&lt;b&gt;A-08 · DER (6/6) — Depósito, stock y auditoría de precios&lt;/b&gt;" style="text;html=1;fontSize=17;align=left" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="06_stock_auditoria-leg" value="Notación: K = clave candidata respaldada [R] · I = inferida · P = pendiente de validación · AK = alterna · K/FK = componente de clave y foránea · FK → subrogada de cabecera/roja (débil: clave propietaria + parcial). Colores: azul = fuerte · verde (borde discontinuo) = débil · naranja = asociativa · amarillo = inventario · violeta = supertipo · violeta claro = subtipo. Cardinalidad &quot;A x..y — z..w B&quot; por extremo (A-04); * = extremo inferido. Cajas grises = referencia repetida de otra página." style="text;html=1;fontSize=9;align=left;fillColor=#fafafa;strokeColor=#cccccc;rounded=1" vertex="1" parent="1"><mxGeometry x="30" y="52" width="820" height="30" as="geometry"/></mxCell><mxCell id="06_stock_auditoria-Vino_s" value="&lt;b&gt;Vino&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;codigo  [K·inf]&lt;br/&gt;nombre&lt;br/&gt;anada&lt;br/&gt;volumen_ml&lt;br/&gt;precio&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="132" as="geometry"/></mxCell><mxCell id="06_stock_auditoria-StockDep" value="&lt;b&gt;Stock de depósito&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[inventario]&lt;/font&gt;&lt;br/&gt;vino  [K/FK]&lt;br/&gt;cantidad  (RN-09: ≥0; P-6 pend.)&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Inventario único depósito. Candidata PK: vino [I cond. a 1 fila por vino] — D-3/AMB-11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="200" height="87" as="geometry"/></mxCell><mxCell id="06_stock_auditoria-Auditoria" value="&lt;b&gt;Auditoría de precio&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[inventario]&lt;/font&gt;&lt;br/&gt;id_auditoria  [K]&lt;br/&gt;vino  [FK]&lt;br/&gt;precio_anterior&lt;br/&gt;precio_nuevo&lt;br/&gt;fecha_hora&lt;br/&gt;usuario  (Q-07)&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: id_auditoria [R · sec. 5]&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;AK (vino, fecha_hora) [P: hipótesis técnica AU-2] · RN-13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="200" height="160" as="geometry"/></mxCell><mxCell id="06_stock_auditoria-Sala_s" value="&lt;b&gt;Sala de venta&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;id_sala  [K]&lt;br/&gt;calle&lt;br/&gt;numero&lt;br/&gt;dia_cierre&lt;br/&gt;localidad&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="132" as="geometry"/></mxCell><mxCell id="06_stock_auditoria-StockSala" value="&lt;b&gt;Stock de sala&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[inventario]&lt;/font&gt;&lt;br/&gt;sala  [K/FK]&lt;br/&gt;vino  [K/FK]&lt;br/&gt;cantidad  (RN-09: ≥0; P-6 pend.)&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Inventario por par. Candidata PK: (sala, vino) = SS-1 [R · textual sec. 5]&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Fila ausente ≠ cantidad 0 (AMB-11)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="200" height="115" as="geometry"/></mxCell><mxCell id="06_stock_auditoria-Transferencia" value="&lt;b&gt;Transferencia&lt