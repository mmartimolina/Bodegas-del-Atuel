l id="03_comercial-Exportador" value="&lt;b&gt;Exportador&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[subtipo]&lt;/font&gt;&lt;br/&gt;id_cliente  [PK/FK heredada · DEC-13]&lt;br/&gt;pais&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;SUBTIPO con PK/FK heredada (DEC-13)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f7f0fa;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="745" width="200" height="87" as="geometry"/></mxCell><mxCell id="03_comercial-Permiso" value="&lt;b&gt;Permiso de exportación&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;codigo  [K·pend]&lt;br/&gt;exportador  [FK·inf]&lt;br/&gt;fecha_emision  [K·pend]&lt;br/&gt;fecha_vencimiento&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidatas PK pendientes (PerK): codigo [P]  |  (exportador, fecha_emision) [P]&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;RN-07: vencimiento &amp;gt; emisión (CHECK)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="200" height="130" as="geometry"/></mxCell><mxCell id="03_comercial-c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="03_comercial-Localidad" target="03_comercial-Sala"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03_comercial-c1-lbl" value="REL-01  Localidad 0*..N — Sala 1..1  (mín. 0 inferido: AMB-01) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="03_comercial-c1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="03_comercial-c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="03_comercial-Sala" target="03_comercial-Empleado"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03_comercial-c2-lbl" value="REL-02  Sala 2*..N — Empleado 1..1  (mín. 2 de &quot;varios&quot;; no definitivo: AMB-02) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="03_comercial-c2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="03_comercial-c3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="03_comercial-Localidad" target="03_comercial-Cliente"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03_comercial-c3-lbl" value="REL-03  Localidad 0*..N — Cliente 1*..1 [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="03_comercial-c3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="03_comercial-c4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="03_comercial-Cliente" target="03_comercial-Socio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03_comercial-c4-lbl" value="REL-15  especialización total y disjunta (DEC-11/12)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="03_comercial-c4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="03_comercial-c5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="03_comercial-Cliente" target="03_comercial-Distribuidor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03_comercial-c5-lbl" value="REL-15  especialización total y disjunta (DEC-11/12)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="03_comercial-c5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="03_comercial-c6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="03_comercial-Cliente" target="03_comercial-Exportador"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03_comercial-c6-lbl" value="REL-15  especialización total y disjunta (DEC-11/12)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="03_comercial-c6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="03_comercial-c7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="03_comercial-Exportador" target="03_comercial-Permiso"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03_comercial-c7-lbl" value="REL-16  Exportador 0..N — Permiso 1*..1 [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="03_comercial-c7"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="03_comercial-note0" value="Jerarquía total y disjunta adoptada: cada Cliente pertenece exactamente a uno de los tres subtipos (DEC-11/12). Estrategia supertipo + subtipos adoptada (DEC-13). Las claves foráneas por sí solas no garantizan totalidad ni exclusividad; mecanismos adicionales de integridad pendientes. Revisión de Persona B pendiente." style="text;html=1;fontSize=9;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="680" y="700" width="380" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="der-04_ventas" name="04_ventas"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="04_ventas-title" value="&lt;b&gt;A-08 · DER (4/6) — Ventas (comprobante y renglones)&lt;/b&gt;" style="text;html=1;fontSize=17;align=left" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="04_ventas-leg" value="Notación: K = clave candidata respaldada [R] · I = inferida · P = pendiente de validación · AK = alterna · K/FK = componente de clave y foránea · FK → subrogada de cabecera/roja (débil: clave propietaria + parcial). Colores: azul = fuerte · verde (borde discontinuo) = débil · naranja = asociativa · amarillo = inventario · violeta = supertipo · violeta claro = subtipo. Cardinalidad &quot;A x..y — z..w B&quot; por extremo (A-04); * = extremo inferido. Cajas grises = referencia repetida de otra página." style="text;html=1;fontSize=9;align=left;fillColor=#fafafa;strokeColor=#cccccc;rounded=1" vertex="1" parent="1"><mxGeometry x="30" y="52" width="820" height="30" as="geometry"/></mxCell><mxCell id="04_ventas-Cliente_v" value="&lt;b&gt;Cliente&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[supertipo]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;id_cliente  [K]&lt;br/&gt;nombre&lt;br/&gt;tipo_doc + n_doc&lt;br/&gt;direccion&lt;br/&gt;localidad&lt;br/&gt;fecha_alta&lt;br/&gt;descuento&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 03 (jerarquía total y disjunta; DEC-11/12/13)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="162" as="geometry"/></mxCell><mxCell id="04_ventas-Sala_v" value="&lt;b&gt;Sala de venta&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;id_sala  [K]&lt;br/&gt;calle&lt;br/&gt;numero&lt;br/&gt;dia_cierre&lt;br/&gt;localidad&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="200" height="132" as="geometry"/></mxCell><mxCell id="04_ventas-Comprobante" value="&lt;b&gt;Comprobante&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;numero  [K·pend]&lt;br/&gt;fecha&lt;br/&gt;subtotal *  (derivado RN-08)&lt;br/&gt;descuento *  (derivado RN-08)&lt;br/&gt;total *  (derivado RN-08)&lt;br/&gt;cliente  [FK]&lt;br/&gt;sala  [FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidatas PK pendientes (CompK-a): numero [P]  |  (sala, numero) [P] (global vs por sala)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="200" height="162" as="geometry"/></mxCell><mxCell id="04_ventas-RenglonCompr" value="&lt;b&gt;Renglón de comprobante&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[asociativa]&lt;/font&gt;&lt;br/&gt;comprobante  [K/FK]&lt;br/&gt;vino  [K/FK]&lt;br/&gt;cantidad&lt;br/&gt;precio_unitario  (histórico RN-01)&lt;br/&gt;descuento  (Q-05)&lt;br/&gt;subtotal  (derivado RN-08)&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: (comprobante, vino) = RK-1 [R · textual sec. 5]&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;La clave implica: un vino no se repite en un comprobante (A-05 §12)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="230" height="160" as="geometry"/></mxCell><mxCell id="04_ventas-Vino_v" value="&lt;b&gt;Vino&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;codigo  [K·inf]&lt;br/&gt;nombre&lt;br/&gt;anada&lt;br/&gt;volumen_ml&lt;br/&gt;precio&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="200" height="132" as="geometry"/></mxCell><mxCell id="04_ventas-v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="04_ventas-Cliente_v" target="04_ventas-Comprobante"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="04_ventas-v1-lbl" value="REL-12  Cliente 0*..N* — Comprobante 1..1  (D4/D6 respaldan &quot;socios sin compras&quot;; resto inferido) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="04_ventas-v1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="04_ventas-v2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="04_ventas-Sala_v" target="04_ventas-Comprobante"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="04_ventas-v2-lbl" value="REL-13  Sala 0*..N — Comprobante 1..1  [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="04_ventas-v2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="04_ventas-v3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="04_ventas-Comprobante" target="04_ventas-RenglonCompr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="04_ventas-v3-lbl" value="REL-14  Comprobante 1*..N* vinos  (mín./máx. inferidos: AMB-10a) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="04_ventas-v3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="04_ventas-v4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="04_ventas-RenglonCompr" target="04_ventas-Vino_v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="04_ventas-v4-lbl" value="REL-14  Vino 0*..N comprobantes  [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="04_ventas-v4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="der-05_logistica" name="05_logistica"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="797" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="05_logistica-title" value="&lt;b&gt;A-08 · DER (5/6) — Logística (transportista y aprovisionamiento)&lt;/b&gt;" style="text;html=1;fontSize=17;align=left" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="05_logistica-leg" value="Notación: K = clave candidata respaldada [R] · I = inferida · P = pendiente de validación · AK = alterna · K/FK = componente de clave y foránea · FK → subrogada de cabecera/roja (débil: clave propietaria + parcial). Colores: azul = fuerte · verde (borde discontinuo) = débil · naranja = asociativa · amarillo = inventario · violeta = supertipo · violeta claro = subtipo. Cardinalidad &quot;A x..y — z..w B&quot; por extremo (A-04); * = extremo inferido. Cajas grises = referencia repetida de otra página." style="text;html=1;fontSize=9;align=left;fillColor=#fafafa;strokeColor=#cccccc;rounded=1" vertex="1" parent="1"><mxGeometry x="30" y="52" width="820" height="30" as="geometry"/></mxCell><mxCell id="05_logistica-Transportista" value="&lt;b&gt;Transportista&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;codigo  [K·pend]&lt;br/&gt;razon_social&lt;br/&gt;cuit  [K·inf]&lt;br/&gt;email&lt;br/&gt;telefono&lt;br/&gt;domicilio&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidatas PK pendientes (TK): codigo [P]  |  cuit [I dominial]  |  ID: no hay &amp;quot;ID&amp;quot; en sec. 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="147" as="geometry"/></mxCell><mxCell id="05_logistica-Bodega_l" value="&lt;b&gt;Bodega&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;cuit  [K]&lt;br/&gt;razon_social&lt;br/&gt;domicilio&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="102" as="geometry"/></mxCell><mxCell id="05_logistica-Ingreso" value="&lt;b&gt;Ingreso&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;codigo  [K·pend]&lt;br/&gt;fecha  (semántica Q-03)&lt;br/&gt;estado  (ENUM RN-10)&lt;br/&gt;transportista  [FK]&lt;br/&gt;bodega_origen  [FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidatas PK pendientes (IK): codigo [P]  |  (bodega_origen, codigo) [P]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="200" height="132" as="geometry"/></mxCell><mxCell id="05_logistica-TCL" value="&lt;b&gt;Transportista–Localidad&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[asociativa]&lt;/font&gt;&lt;br/&gt;transportista  [K/FK]&lt;br/&gt;localidad  [K/FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;N:M sin atributos (cobertura REL-17)&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: (transportista, localidad) [I] — D-9&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;≠ zona del Distribuidor (AMB-15 resuelta)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="200" height="113" as="geometry"/></mxCell><mxCell id="05_logistica-Localidad_l" value="&lt;b&gt;Localidad&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;codigo_postal&lt;br/&gt;nombre&lt;br/&gt;provincia&lt;br/&gt;encargado_regional&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="320" y="590" width="200" height="117" as="geometry"/></mxCell><mxCell id="05_logistica-RenglonIngreso" value="&lt;b&gt;Renglón de ingreso&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[asociativa]&lt;/font&gt;&lt;br/&gt;ingreso  [K/FK]&lt;br/&gt;vino  [K/FK]&lt;br/&gt;cantidad&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: (ingreso, vino) [I analogía; sin clave textual] — RI-a, AMB-10b/14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;vert