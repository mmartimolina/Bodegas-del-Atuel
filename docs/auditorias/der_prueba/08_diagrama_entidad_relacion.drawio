<mxfile host="app.diagrams.net" agent="gen_der.py (layout del equipo); contenido: A-01..A-07" version="24.7.7" type="device" pages="7"><diagram id="der-00_mapa" name="00_mapa"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="700" pageHeight="840"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mapa-title" value="&lt;b&gt;A-08 · DER — Mapa de módulos&lt;/b&gt;" style="text;html=1;fontSize=17;align=left" vertex="1" parent="1"><mxGeometry x="30" y="20" width="500" height="30" as="geometry"/></mxCell><mxCell id="mapa-m0" value="&lt;b&gt;Módulo 1 — Producción de uva (pág. 01)&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;10&quot;&gt;Finca · Parcela (débil, identificada por Finca) · Cepa · Lote de uva · Análisis de calidad&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#555555&quot;&gt;REL-04, REL-05, REL-06, REL-08  +  REL-07 (Lote→Bodega, cruz a módulo 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#888888" vertex="1" parent="1"><mxGeometry x="30" y="60" width="620" height="88" as="geometry"/></mxCell><mxCell id="mapa-m1" value="&lt;b&gt;Módulo 2 — Elaboración de vinos (pág. 02)&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;10&quot;&gt;Bodega · Vino · Maridaje · Composición (asoc. con atributo) · Vino–Maridaje (asoc. sin atributos)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#555555&quot;&gt;REL-09, REL-10, REL-11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#888888" vertex="1" parent="1"><mxGeometry x="30" y="160" width="620" height="88" as="geometry"/></mxCell><mxCell id="mapa-m2" value="&lt;b&gt;Módulo 3 — Red comercial y jerarquía (pág. 03)&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;10&quot;&gt;Localidad · Sala de venta · Empleado · Cliente (supertipo) · Socio / Distribuidor / Exportador (subtipos) · Permiso de exportación&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#555555&quot;&gt;REL-01, REL-02, REL-03, REL-15 (jerarquía total y disjunta, DEC-11/12/13), REL-16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#888888" vertex="1" parent="1"><mxGeometry x="30" y="260" width="620" height="88" as="geometry"/></mxCell><mxCell id="mapa-m3" value="&lt;b&gt;Módulo 4 — Ventas (pág. 04)&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;10&quot;&gt;Comprobante · Renglón de comprobante (asoc. con atributos; precio histórico)  [Cliente / Sala / Vino repetidas como referencia]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#555555&quot;&gt;REL-12, REL-13, REL-14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#888888" vertex="1" parent="1"><mxGeometry x="30" y="360" width="620" height="88" as="geometry"/></mxCell><mxCell id="mapa-m4" value="&lt;b&gt;Módulo 5 — Logística (pág. 05)&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;10&quot;&gt;Transportista · Transportista–Localidad (cobertura, asoc.) · Ingreso · Renglón de ingreso (asoc.)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#555555&quot;&gt;REL-17, REL-18, REL-19, REL-20&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#888888" vertex="1" parent="1"><mxGeometry x="30" y="460" width="620" height="88" as="geometry"/></mxCell><mxCell id="mapa-m5" value="&lt;b&gt;Módulo 6 — Depósito, stock y auditoría (pág. 06)&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;10&quot;&gt;Stock de depósito · Auditoría de precio · Stock de sala · Transferencia · Renglón de transferencia (asoc.)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#555555&quot;&gt;REL-21, REL-22, REL-23, REL-24, REL-25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#888888" vertex="1" parent="1"><mxGeometry x="30" y="560" width="620" height="88" as="geometry"/></mxCell><mxCell id="mapa-nota" value="Modelo completo: 29 conceptos (A-01 §2; 27 si los subtipos se cuentan como jerarquía). Jerarquía Cliente: total y disjunta, según DEC-11/12; estrategia A-06 (supertipo + 3 subtipos), según DEC-13. Revisión de Persona B pendiente. Claves: las cajas muestran claves candidatas y decisiones adoptadas, con su estado (R respaldada / I inferida / P pendiente). Cardinalidades: notación independiente por extremo de A-04 (&quot;A x..y — z..w B&quot;); * = extremo inferido o condicionado; mínimo 0 = participación parcial." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1"><mxGeometry x="30" y="670" width="620" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="der-01_produccion" name="01_produccion"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="01_produccion-title" value="&lt;b&gt;A-08 · DER (1/6) — Producción de uva&lt;/b&gt;" style="text;html=1;fontSize=17;align=left" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="01_produccion-leg" value="Notación: K = clave candidata respaldada [R] · I = inferida · P = pendiente de validación · AK = alterna · K/FK = componente de clave y foránea · FK → subrogada de cabecera/roja (débil: clave propietaria + parcial). Colores: azul = fuerte · verde (borde discontinuo) = débil · naranja = asociativa · amarillo = inventario · violeta = supertipo · violeta claro = subtipo. Cardinalidad &quot;A x..y — z..w B&quot; por extremo (A-04); * = extremo inferido. Cajas grises = referencia repetida de otra página." style="text;html=1;fontSize=9;align=left;fillColor=#fafafa;strokeColor=#cccccc;rounded=1" vertex="1" parent="1"><mxGeometry x="30" y="52" width="820" height="30" as="geometry"/></mxCell><mxCell id="01_produccion-Finca" value="&lt;b&gt;Finca&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;id_finca  [K]&lt;br/&gt;nombre&lt;br/&gt;superficie&lt;br/&gt;departamento&lt;br/&gt;provincia&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: id_finca [R · &amp;quot;ID&amp;quot; sec. 5]&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;(natural vs. subrogada: decisión de diseño pendiente)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="145" as="geometry"/></mxCell><mxCell id="01_produccion-Parcela" value="&lt;b&gt;Parcela&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[débil]&lt;/font&gt;&lt;br/&gt;finca  [K/FK propietaria]&lt;br/&gt;n_parcela  [K parcial]&lt;br/&gt;superficie&lt;br/&gt;anio_plantacion&lt;br/&gt;cepa  [FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;DÉBIL de Finca (3.2, 5§, etapa 1-2)&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: (finca, n_parcela) = ParK-1 [R · triple cita]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#666666;fontSize=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="200" height="145" as="geometry"/></mxCell><mxCell id="01_produccion-Cepa" value="&lt;b&gt;Cepa&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;id  [K]&lt;br/&gt;nombre&lt;br/&gt;tipo&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: id [R]&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;nombre: AK [P] (unicidad no declarada; CeK-2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="200" height="115" as="geometry"/></mxCell><mxCell id="01_produccion-Lote" value="&lt;b&gt;Lote de uva&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;n_lote  [K·pend]&lt;br/&gt;parcela (finca+n_parcela)  [FK]&lt;br/&gt;campania&lt;br/&gt;fecha_cosecha&lt;br/&gt;kg&lt;br/&gt;bodega_destino  [FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidatas PK pendientes (Q-02/LoteK-a):&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;n_lote [P]  |  (parcela, campania) [P: unicidad textual UNIQUE etapa 2; minimalidad no demostrada]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="200" height="160" as="geometry"/></mxCell><mxCell id="01_produccion-Analisis" value="&lt;b&gt;Análisis de calidad&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;id_analisis  [K]&lt;br/&gt;lote  [FK]&lt;br/&gt;fecha&lt;br/&gt;brix&lt;br/&gt;ph&lt;br/&gt;acidez&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: id_analisis [R] (identidad de fila dudosa: D-6/Q-06)&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;AK (lote, fecha) [P] (AK-2 sin garantía)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="200" height="160" as="geometry"/></mxCell><mxCell id="01_produccion-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="01_produccion-Finca" target="01_produccion-Parcela"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01_produccion-e1-lbl" value="REL-04  Finca 1*..N — Parcela 1..1  (identificadora; participación total de Parcela) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="01_produccion-e1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="01_produccion-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="01_produccion-Parcela" target="01_produccion-Cepa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01_produccion-e2-lbl" value="REL-05  Parcela 1..1 — Cepa 0*..N*  (cepa plantada; sin historia: D-7/AMB-12) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="01_produccion-e2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="01_produccion-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="01_produccion-Parcela" target="01_produccion-Lote"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01_produccion-e3-lbl" value="REL-06  Parcela 0*..N — Lote 1*..1  (máx. 1 por campaña: RN-04) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="01_produccion-e3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="01_produccion-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="01_produccion-Lote" target="01_produccion-Analisis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01_produccion-e4-lbl" value="REL-08  Lote 1..N* — Análisis 1*..1*  (ambos inferidos) [P]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="01_produccion-e4"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="01_produccion-note0" value="Lote → Bodega (REL-07, Lote 1..1 — Bodega 0*..N): relación ENTRE MÓDULOS (módulo 2, pág. 02). Rol &quot;bodega destino&quot; ≠ bodega elaboradora del Vino ≠ bodega origen del Ingreso (AMB-06). [P]" style="text;html=1;fontSize=9;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="520" width="460" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="der-02_elaboracion" name="02_elaboracion"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="02_elaboracion-title" value="&lt;b&gt;A-08 · DER (2/6) — Elaboración de vinos&lt;/b&gt;" style="text;html=1;fontSize=17;align=left" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="02_elaboracion-leg" value="Notación: K = clave candidata respaldada [R] · I = inferida · P = pendiente de validación · AK = alterna · K/FK = componente de clave y foránea · FK → subrogada de cabecera/roja (débil: clave propietaria + parcial). Colores: azul = fuerte · verde (borde discontinuo) = débil · naranja = asociativa · amarillo = inventario · violeta = supertipo · violeta claro = subtipo. Cardinalidad &quot;A x..y — z..w B&quot; por extremo (A-04); * = extremo inferido. Cajas grises = referencia repetida de otra página." style="text;html=1;fontSize=9;align=left;fillColor=#fafafa;strokeColor=#cccccc;rounded=1" vertex="1" parent="1"><mxGeometry x="30" y="52" width="820" height="30" as="geometry"/></mxCell><mxCell id="02_elaboracion-Bodega" value="&lt;b&gt;Bodega&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;cuit  [K — UNIQUE etapa 2]&lt;br/&gt;razon_social&lt;br/&gt;domicilio&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: cuit [R por UNIQUE textual; PK no decidida; alternativa ID subrogado abierta]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="102" as="geometry"/></mxCell><mxCell id="02_elaboracion-Vino" value="&lt;b&gt;Vino&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;codigo  [K·inf: API /vinos/{cod}; sin UNIQUE textual]&lt;br/&gt;nombre&lt;br/&gt;tipo&lt;br/&gt;anada&lt;br/&gt;volumen_ml&lt;br/&gt;graduacion&lt;br/&gt;precio  (RN-01: único en red, &amp;gt; 0)&lt;br/&gt;bodega  [FK]&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidatas PK pendientes (VK): codigo [I]  |  (nombre, anada, volumen_ml) [P: unicidad textual; minimalidad no demostrada]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="220" height="177" as="geometry"/></mxCell><mxCell id="02_elaboracion-Maridaje" value="&lt;b&gt;Maridaje&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt;&lt;br/&gt;id  [K]&lt;br/&gt;nombre&lt;br/&gt;temperatura&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: id [R]&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;nombre: AK [P] (sin UNIQUE textual; MK-2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="200" height="115" as="geometry"/></mxCell><mxCell id="02_elaboracion-Cepa_ref" value="&lt;b&gt;Cepa&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[fuerte]&lt;/font&gt; &lt;font size=&quot;8&quot; color=&quot;#777777&quot;&gt;(referencia)&lt;/font&gt;&lt;br/&gt;id  [K]&lt;br/&gt;nombre&lt;br/&gt;tipo&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Definida en pág. 01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=65;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="102" as="geometry"/></mxCell><mxCell id="02_elaboracion-Composicion" value="&lt;b&gt;Composición (vino–cepa)&lt;/b&gt; &lt;font size=&quot;9&quot; color=&quot;#444444&quot;&gt;[asociativa]&lt;/font&gt;&lt;br/&gt;vino  [K/FK]&lt;br/&gt;cepa  [K/FK]&lt;br/&gt;porcentaje  (RN-05: suma 100 por vino)&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;N:M con atributo (REL-10)&lt;/font&gt;&lt;br/&gt;&lt;font size=&quot;9&quot; color=&quot;#7a0000&quot;&gt;Candidata PK: (vino, cepa) = ComK-1 [I] — ComK-a abierto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fill