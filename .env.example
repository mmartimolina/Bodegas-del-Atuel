POSTGRES_DB=bodegas_atuel
POSTGRES_USER=bodegas_app
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5433

# API y frontend (Compose sobreescribe DB_HOST/DB_PORT para la red interna).
DB_HOST=localhost
DB_PORT=5433
DB_ROLE=bodegas_api
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080
FRONTEND_API_BASE_URL=http://localhost:8000

# Carga masiva (db/seed/generador_masivo.py). Copiar este archivo como
# db/seed/.env (esta en .gitignore) o definir las variables en el entorno.
# PGPASSWORD nunca se commitea: si una clave quedo en el historial del repo,
# cambiala en PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=bodegas_del_atuel
PGPASSWORD=cambiar_esta_clave
